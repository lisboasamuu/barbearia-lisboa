{
  "redirects": [
    {
      "source": "/agendar",
      "destination": "/barbearia-lisboa/agendar",
      "permanent": false
    },
    {
      "source": "/agenda",
      "destination": "/barbearia-lisboa/agenda",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ]
}
